<Page x:Class="SteamEyaWinUI.Pages.Cs2LocalSettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="28,20,28,8" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4"><TextBlock Text="CS2 统一配置" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="独立保存一套模板，确认后应用到所有本机 CS2 账号" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   <ProgressRing x:Name="BusyRing" Grid.Column="1" Width="28" Height="28" IsActive="False"/>
  </Grid>
  <StackPanel Grid.Row="1" Spacing="8">
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="TemplateNameBox" PlaceholderText="我的统一配置" AutomationProperties.Name="配置模板名称" TextChanging="NameChanged"/>
    <Button x:Name="ImportButton" Grid.Column="1" Content="导入模板"><Button.Flyout><MenuFlyout>
     <MenuFlyoutItem Text="使用应用默认模板" Click="DefaultClicked"/>
     <MenuFlyoutItem Text="从配置文件夹导入" Click="ImportFolderClicked"/>
     <MenuFlyoutItem Text="从本机账号导入一次" Click="ImportAccountClicked"/>
    </MenuFlyout></Button.Flyout></Button>
    <Button x:Name="ExportButton" Grid.Column="2" Content="导出模板" Click="ExportClicked"/>
    <Button x:Name="RestoreButton" Grid.Column="3" Content="恢复备份" Click="RestoreClicked"/>
   </Grid>
   <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="True" Message="正在读取统一模板…"/>
  </StackPanel>
  <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="TabsPanel" Orientation="Horizontal" Spacing="4"/></ScrollViewer>
   <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索设置" TextChanged="SearchChanged" AutomationProperties.Name="搜索 CS2 设置"/>
  </Grid>
  <ScrollViewer x:Name="SettingsScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel Spacing="12">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="18,12"><StackPanel Spacing="5">
     <TextBlock x:Name="CategoryTitle" FontSize="20" FontWeight="SemiBold"/>
     <TextBlock Text="保存仅更新模板。应用仅覆盖本地已验证参数；Steam Cloud 之后可能同步回旧配置。参数依据及未支持项见开发文档。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel></Border>
    <StackPanel x:Name="DisplayPanel" Spacing="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
     <TextBlock Text="基础视频 · 本机显示设备模式" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="设备列表仅用于校验分辨率，不写入未经验证的 CS2 显示器编号。刷新率、宽高比和显示模式暂保留导入值；需要先导入游戏生成的版本 16 视频配置。" TextWrapping="Wrap"/>
     <ComboBox x:Name="DisplayBox" Header="显示设备（仅校验模式）" SelectionChanged="DisplayChanged" HorizontalAlignment="Stretch"/>
     <ComboBox x:Name="ResolutionBox" Header="受设备支持的分辨率" SelectionChanged="ResolutionChanged" HorizontalAlignment="Stretch"/>
    </StackPanel>
    <StackPanel x:Name="RowsPanel" Spacing="3"/>
    <TextBlock x:Name="EmptyText" Text="没有符合搜索条件的设置。" TextWrapping="Wrap" Margin="12"/>
    <Border x:Name="BindingsPanel" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel Spacing="10">
     <TextBlock Text="键位绑定" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="选择动作覆盖模板中的指定按键。未改动的自定义命令保留；批量应用只部署已验证的标准动作。" TextWrapping="Wrap"/>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="KeyBox" Header="按键" HorizontalAlignment="Stretch" SelectionChanged="KeyChanged"/>
      <ComboBox x:Name="ActionBox" Grid.Column="1" Header="动作" HorizontalAlignment="Stretch" SelectionChanged="ActionChanged"/>
     </Grid><TextBlock x:Name="BindingSummary" TextWrapping="Wrap"/>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="4" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" ColumnSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="DirtyText" Text="没有未保存修改" VerticalAlignment="Center" TextWrapping="Wrap"/>
   <Button x:Name="UndoButton" Grid.Column="1" Content="撤销修改" Click="UndoClicked"/>
   <Button x:Name="SaveButton" Grid.Column="2" Content="保存配置" Click="SaveClicked"/>
   <Button x:Name="ApplyButton" Grid.Column="3" Content="应用到所有账号" Click="ApplyClicked" Style="{StaticResource AccentButtonStyle}"/>
  </Grid>
 </Grid>
</Page>
