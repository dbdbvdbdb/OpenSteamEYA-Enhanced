<Page x:Class="SteamEyaWinUI.Pages.Cs2LocalSettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="28,20,28,8" RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4"><TextBlock Text="CS2 本地设置" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="关闭游戏后调整设置 · 保存前自动备份" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   <ProgressRing x:Name="BusyRing" Grid.Column="1" Width="28" Height="28" IsActive="False"/>
  </Grid>
  <StackPanel Grid.Row="1" Spacing="12">
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="ProfilesBox" PlaceholderText="选择本机 Steam 账号" HorizontalAlignment="Stretch" SelectionChanged="ProfileChanged" AutomationProperties.Name="本机 Steam 账号"/>
    <Button x:Name="ReloadButton" Grid.Column="1" Content="重新读取" Click="ReloadClicked"/>
   </Grid>
   <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" Message="正在读取本地配置…"/>
  </StackPanel>
  <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel x:Name="TabsPanel" Orientation="Horizontal" Spacing="4"/>
   </ScrollViewer>
   <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="搜索设置" TextChanged="SearchChanged" AutomationProperties.Name="搜索 CS2 设置"/>
  </Grid>
  <ScrollViewer x:Name="SettingsScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel Spacing="14">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20,14">
     <StackPanel Spacing="6"><TextBlock x:Name="CategoryTitle" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="CategoryHelp" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    </Border>
    <StackPanel x:Name="RowsPanel" Spacing="2"/>
    <TextBlock x:Name="EmptyText" Text="现有配置中没有可编辑的对应设置。请先在游戏中生成该账号配置。" TextWrapping="Wrap" Margin="12"/>
    <Border x:Name="BindingsPanel" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
     <StackPanel Spacing="12"><TextBlock Text="键位绑定" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="选择按键与动作进行覆盖。未改动的默认绑定和自定义命令保持原样。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="KeyBox" Header="按键" HorizontalAlignment="Stretch" SelectionChanged="KeyChanged"/>
       <ComboBox x:Name="ActionBox" Grid.Column="1" Header="动作" HorizontalAlignment="Stretch" SelectionChanged="ActionChanged"/>
      </Grid>
      <TextBlock x:Name="BindingSummary" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="4" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="DirtyText" Text="没有未保存修改" VerticalAlignment="Center" TextWrapping="Wrap"/>
   <Button x:Name="RestoreButton" Grid.Column="1" Content="恢复最近备份" Click="RestoreClicked"/>
   <Button x:Name="UndoButton" Grid.Column="2" Content="撤销修改" Click="UndoClicked"/>
   <Button x:Name="SaveButton" Grid.Column="3" Content="保存并同步云端" Style="{StaticResource AccentButtonStyle}" Click="SaveClicked"/>
  </Grid>
 </Grid>
</Page>
