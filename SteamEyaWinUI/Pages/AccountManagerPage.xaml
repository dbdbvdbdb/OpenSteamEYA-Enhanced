<Page x:Class="SteamEyaWinUI.Pages.AccountManagerPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:pages="using:SteamEyaWinUI.Pages"
 xmlns:models="using:SteamEyaWinUI.Models" NavigationCacheMode="Required">
 <Grid Padding="20,16,20,14" RowSpacing="10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- 页头 -->
  <StackPanel Spacing="2" VerticalAlignment="Center">
   <TextBlock Text="白号管理" Style="{StaticResource PclTitleTextStyle}" FontSize="22"/>
   <TextBlock x:Name="Summary" Text="独立密码记录 · 关联原有登录凭证" Style="{StaticResource PclSubtitleTextStyle}"/>
  </StackPanel>

  <!-- 工具栏 -->
  <Border Grid.Row="1" Style="{StaticResource PclToolbarCardStyle}">
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="AddAccountButton" Content="＋ 添加账号" Style="{StaticResource PclPrimaryButtonStyle}" VerticalAlignment="Center">
     <Button.Flyout><MenuFlyout>
      <MenuFlyoutItem Text="单个添加模式" Click="Add_Click"/>
      <MenuFlyoutItem x:Name="BatchAddMenuItem" Text="批量添加模式" Click="BatchAdd_Click"/>
     </MenuFlyout></Button.Flyout>
    </Button>
    <TextBox x:Name="Search" Width="320" VerticalAlignment="Center"
             PlaceholderText="搜索昵称、账号、SteamID、备注" TextChanged="FilterChanged"
             Background="{ThemeResource PclSurfaceAltBrush}" BorderBrush="{ThemeResource PclBorderBrush}"
             BorderThickness="1" CornerRadius="8" Padding="10,6"/>
    <ComboBox x:Name="GroupFilter" Width="118" SelectionChanged="SelectionFilterChanged" VerticalAlignment="Center"/>
    <DropDownButton x:Name="ManageButton" Content="管理工具" Style="{StaticResource PclSecondaryButtonStyle}" VerticalAlignment="Center">
     <DropDownButton.Flyout><MenuFlyout>
      <MenuFlyoutItem Text="关联已有账号" Click="Existing_Click"/>
      <MenuFlyoutItem Text="导入" Click="Import_Click"/>
      <MenuFlyoutItem Text="导出" Click="Export_Click"/>
      <MenuFlyoutItem Text="备份与恢复" Click="Backup_Click"/>
      <MenuFlyoutSeparator/>
      <MenuFlyoutItem Text="管理分组" Click="Groups_Click"/>
      <MenuFlyoutItem Text="管理设置" Click="Settings_Click"/>
      <MenuFlyoutItem Text="刷新资料" Click="Refresh_Click"/>
     </MenuFlyout></DropDownButton.Flyout>
    </DropDownButton>
   </StackPanel>
  </Border>

  <!-- 筛选条 -->
  <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" Padding="2,0">
   <StackPanel Orientation="Horizontal" Spacing="6">
    <ComboBox x:Name="SortChoice" Width="118" VerticalAlignment="Center" SelectionChanged="SortChanged">
     <ComboBoxItem Content="自定义排序" Tag="custom"/><ComboBoxItem Content="昵称" Tag="nickname"/>
     <ComboBoxItem Content="登录账号" Tag="login"/><ComboBoxItem Content="最近使用" Tag="recent"/>
     <ComboBoxItem Content="CS2 等级" Tag="level"/><ComboBoxItem Content="收藏优先" Tag="favorite"/>
    </ComboBox>
    <ComboBox x:Name="ViewChoice" Width="108" VerticalAlignment="Center" SelectionChanged="ViewChanged">
     <ComboBoxItem Content="精美卡片" Tag="cards"/><ComboBoxItem Content="紧凑列表" Tag="list"/>
    </ComboBox>
    <ToggleButton x:Name="Privacy" Content="隐私模式" Click="Privacy_Click" Style="{StaticResource PclPillToggleStyle}"/>
    <StackPanel x:Name="SelectionActions" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
     <Button x:Name="SelectAll" Content="全选" Click="SelectAll_Click" Style="{StaticResource PclGhostButtonStyle}" ToolTipService.ToolTip="选中当前显示的全部账号"/>
     <Button x:Name="InvertSelection" Content="反选" Click="InvertSelection_Click" Style="{StaticResource PclGhostButtonStyle}" ToolTipService.ToolTip="反转当前显示的账号选择；其他选择保持"/>
     <Button x:Name="ClearSelection" Content="取消全选" Click="ClearSelection_Click" Style="{StaticResource PclGhostButtonStyle}" ToolTipService.ToolTip="清除全部选择，包括筛选隐藏的账号"/>
     <Button x:Name="QuerySelection" Content="查询CS2状态" Click="QuerySelection_Click" Style="{StaticResource PclGhostButtonStyle}" ToolTipService.ToolTip="逐个查询所有已选账号，包括筛选隐藏的选择；无可用 EYA 查询凭据时跳过"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>

  <!-- 卡片区 -->
  <Grid Grid.Row="3">
   <GridView x:Name="Cards" SelectionMode="Multiple" IsItemClickEnabled="False" SelectionChanged="CardsSelectionChanged" ContextRequested="CardsContextRequested"
     CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsStarting="CardsDragStarting" DragItemsCompleted="CardsDragCompleted" SizeChanged="CardsSizeChanged"
     Padding="0,2,0,0">
    <!-- Large/filter-replaced collections must not cascade entrance animations across 100 cards. -->
    <GridView.ItemContainerTransitions><TransitionCollection/></GridView.ItemContainerTransitions>
    <GridView.Resources>
     <!-- The optimized native presenter reads its own radius, not the child card's radius. -->
     <CornerRadius x:Key="GridViewItemCornerRadius">10</CornerRadius>
     <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/>
     <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent"/>
     <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
     <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/>
     <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent"/>
     <SolidColorBrush x:Key="GridViewItemPointerOverBorderBrush" Color="Transparent"/>
     <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="Transparent"/>
     <SolidColorBrush x:Key="GridViewItemSelectedPointerOverBorderBrush" Color="Transparent"/>
     <SolidColorBrush x:Key="GridViewItemSelectedPressedBorderBrush" Color="Transparent"/>
     <SolidColorBrush x:Key="GridViewItemSelectedInnerBorderBrush" Color="Transparent"/>
     <x:Boolean x:Key="GridViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
    </GridView.Resources>
    <!-- 条目是轻量 view-model；真正的控件树由 ItemTemplate 在容器实现时才创建（item 级虚拟化）。 -->
    <GridView.ItemTemplate>
     <DataTemplate x:DataType="models:ManagedAccountCardItem">
      <pages:AccountCard Item="{x:Bind}"/>
     </DataTemplate>
    </GridView.ItemTemplate>
    <GridView.ItemContainerStyle><Style TargetType="GridViewItem">
     <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,12,12"/>
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="CornerRadius" Value="10"/>
     <Setter Property="FocusVisualMargin" Value="0"/>
     <Setter Property="UseSystemFocusVisuals" Value="True"/>
     <Setter Property="Template"><Setter.Value>
      <!-- Preserve the native presenter (keyboard, selection, drag/reorder). Paint only one card outline. -->
      <ControlTemplate TargetType="GridViewItem">
       <ListViewItemPresenter x:Name="Root" ContentTransitions="{TemplateBinding ContentTransitions}"
        Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
        Control.IsTemplateFocusTarget="True" CornerRadius="{TemplateBinding CornerRadius}"
        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
        ContentMargin="{TemplateBinding Padding}" FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
        FocusVisualPrimaryBrush="{ThemeResource PclAccentBrush}" FocusVisualPrimaryThickness="2"
        FocusVisualSecondaryBrush="Transparent" FocusVisualSecondaryThickness="0"
        FocusBorderBrush="{ThemeResource PclAccentBrush}" PointerOverBackground="Transparent" PressedBackground="Transparent"
        SelectedBackground="Transparent" SelectedPointerOverBackground="Transparent" SelectedPressedBackground="Transparent"
        PointerOverBorderBrush="Transparent" SelectedBorderBrush="Transparent" SelectedPointerOverBorderBrush="Transparent"
        SelectedPressedBorderBrush="Transparent" SelectedInnerBorderBrush="Transparent" SelectedBorderThickness="0"
        CheckMode="Overlay" SelectionCheckMarkVisualEnabled="False" CheckBrush="Transparent" CheckBoxBrush="Transparent"
        CheckBoxBorderBrush="Transparent" CheckBoxPointerOverBrush="Transparent" CheckBoxPointerOverBorderBrush="Transparent"
        CheckBoxSelectedBrush="Transparent" CheckBoxSelectedPointerOverBrush="Transparent" CheckBoxSelectedPressedBrush="Transparent"
        CheckPressedBrush="Transparent" CheckBoxPressedBrush="Transparent" CheckBoxPressedBorderBrush="Transparent"
        DisabledOpacity="0.55" DragOpacity="0.8" ReorderHintOffset="12" PlaceholderBackground="Transparent"/>
      </ControlTemplate>
     </Setter.Value></Setter>
    </Style></GridView.ItemContainerStyle>
   </GridView>
   <TextBlock x:Name="EmptyText" Text="暂无账号。添加密码记录，或关联已有账号。" HorizontalAlignment="Center" VerticalAlignment="Center"
              Style="{StaticResource PclCaptionTextStyle}"/>
  </Grid>
 </Grid>
</Page>
