<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SteamEyaWinUI.Pages.Cs2HubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource PclPageBackgroundBrush}"
    Loaded="OnLoaded">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 把「统一配置」「配装」「个性化」收在同一入口下，用胶囊页签切换。 -->
        <Border Grid.Row="0"
                Background="{ThemeResource PclSurfaceBrush}"
                BorderBrush="{ThemeResource PclBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,10,20,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="UnifiedTab" MinWidth="86" MinHeight="32"
                              Style="{StaticResource PclPillToggleStyle}" Click="Tab_Click" Tag="unified" />
                <ToggleButton x:Name="LoadoutTab" MinWidth="72" MinHeight="32"
                              Style="{StaticResource PclPillToggleStyle}" Click="Tab_Click" Tag="loadout" />
                <ToggleButton x:Name="PersonalizeTab" MinWidth="86" MinHeight="32"
                              Style="{StaticResource PclPillToggleStyle}" Click="Tab_Click" Tag="personalize" />
            </StackPanel>
        </Border>

        <Frame x:Name="HubFrame" Grid.Row="1" />
    </Grid>
</Page>
