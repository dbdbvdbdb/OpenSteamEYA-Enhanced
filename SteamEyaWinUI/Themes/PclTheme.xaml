<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        PCL 风格设计令牌（视觉语言参考 Plain Craft Launcher 2 的整体观感：
        浅灰底 + 白色圆角卡片 + 蓝色强调 + 顶部横向导航）。
        本文件只定义自有的颜色、圆角与控件样式，不包含任何来自 PCL 的素材或代码。
    -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="PclAccentColor">#1370F3</Color>
            <Color x:Key="PclAccentHoverColor">#2E82F6</Color>
            <Color x:Key="PclAccentPressedColor">#0E5CD4</Color>
            <Color x:Key="PclAccentSoftColor">#E8F1FE</Color>
            <Color x:Key="PclPageBackgroundColor">#F3F4F6</Color>
            <Color x:Key="PclSurfaceColor">#FFFFFF</Color>
            <Color x:Key="PclSurfaceAltColor">#FAFBFC</Color>
            <Color x:Key="PclSurfaceHoverColor">#F1F3F7</Color>
            <Color x:Key="PclBorderColor">#E3E6EB</Color>
            <Color x:Key="PclBorderStrongColor">#D3D8E0</Color>
            <Color x:Key="PclTextPrimaryColor">#1F2329</Color>
            <Color x:Key="PclTextSecondaryColor">#6B7280</Color>
            <Color x:Key="PclTextTertiaryColor">#9AA1AC</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="PclAccentColor">#1370F3</Color>
            <Color x:Key="PclAccentHoverColor">#2E82F6</Color>
            <Color x:Key="PclAccentPressedColor">#0E5CD4</Color>
            <Color x:Key="PclAccentSoftColor">#E8F1FE</Color>
            <Color x:Key="PclPageBackgroundColor">#F3F4F6</Color>
            <Color x:Key="PclSurfaceColor">#FFFFFF</Color>
            <Color x:Key="PclSurfaceAltColor">#FAFBFC</Color>
            <Color x:Key="PclSurfaceHoverColor">#F1F3F7</Color>
            <Color x:Key="PclBorderColor">#E3E6EB</Color>
            <Color x:Key="PclBorderStrongColor">#D3D8E0</Color>
            <Color x:Key="PclTextPrimaryColor">#1F2329</Color>
            <Color x:Key="PclTextSecondaryColor">#6B7280</Color>
            <Color x:Key="PclTextTertiaryColor">#9AA1AC</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="PclAccentColor">#4A97FF</Color>
            <Color x:Key="PclAccentHoverColor">#63A7FF</Color>
            <Color x:Key="PclAccentPressedColor">#2E7FE8</Color>
            <Color x:Key="PclAccentSoftColor">#1D2C44</Color>
            <Color x:Key="PclPageBackgroundColor">#1B1C1F</Color>
            <Color x:Key="PclSurfaceColor">#252629</Color>
            <Color x:Key="PclSurfaceAltColor">#2B2D31</Color>
            <Color x:Key="PclSurfaceHoverColor">#32343A</Color>
            <Color x:Key="PclBorderColor">#3A3D44</Color>
            <Color x:Key="PclBorderStrongColor">#4A4E57</Color>
            <Color x:Key="PclTextPrimaryColor">#F2F3F5</Color>
            <Color x:Key="PclTextSecondaryColor">#A8ADB8</Color>
            <Color x:Key="PclTextTertiaryColor">#7C828D</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- 画刷 -->
    <SolidColorBrush x:Key="PclAccentBrush" Color="{ThemeResource PclAccentColor}" />
    <SolidColorBrush x:Key="PclAccentHoverBrush" Color="{ThemeResource PclAccentHoverColor}" />
    <SolidColorBrush x:Key="PclAccentPressedBrush" Color="{ThemeResource PclAccentPressedColor}" />
    <SolidColorBrush x:Key="PclAccentSoftBrush" Color="{ThemeResource PclAccentSoftColor}" />
    <SolidColorBrush x:Key="PclPageBackgroundBrush" Color="{ThemeResource PclPageBackgroundColor}" />
    <SolidColorBrush x:Key="PclSurfaceBrush" Color="{ThemeResource PclSurfaceColor}" />
    <SolidColorBrush x:Key="PclSurfaceAltBrush" Color="{ThemeResource PclSurfaceAltColor}" />
    <SolidColorBrush x:Key="PclSurfaceHoverBrush" Color="{ThemeResource PclSurfaceHoverColor}" />
    <SolidColorBrush x:Key="PclBorderBrush" Color="{ThemeResource PclBorderColor}" />
    <SolidColorBrush x:Key="PclBorderStrongBrush" Color="{ThemeResource PclBorderStrongColor}" />
    <SolidColorBrush x:Key="PclTextPrimaryBrush" Color="{ThemeResource PclTextPrimaryColor}" />
    <SolidColorBrush x:Key="PclTextSecondaryBrush" Color="{ThemeResource PclTextSecondaryColor}" />
    <SolidColorBrush x:Key="PclTextTertiaryBrush" Color="{ThemeResource PclTextTertiaryColor}" />

    <!-- 形状与字号 -->
    <CornerRadius x:Key="PclCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="PclControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PclPillCornerRadius">18</CornerRadius>
    <x:Double x:Key="PclTitleFontSize">26</x:Double>
    <x:Double x:Key="PclSectionFontSize">15</x:Double>
    <x:Double x:Key="PclBodyFontSize">13</x:Double>
    <x:Double x:Key="PclCaptionFontSize">12</x:Double>

    <!-- 文字 -->
    <Style x:Key="PclTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PclTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="PclSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PclCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PclSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PclSectionFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextPrimaryBrush}" />
    </Style>

    <Style x:Key="PclBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PclBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextPrimaryBrush}" />
    </Style>

    <Style x:Key="PclCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PclCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextSecondaryBrush}" />
    </Style>

    <!-- 容器 -->
    <Style x:Key="PclCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PclSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PclBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PclCardCornerRadius}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="PclToolbarCardStyle" TargetType="Border" BasedOn="{StaticResource PclCardStyle}">
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- 主按钮 -->
    <Style x:Key="PclPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PclAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource PclControlCornerRadius}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="{StaticResource PclBodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Control.IsTemplateFocusTarget="True" />
                        <ContentPresenter
                            x:Name="Presenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Opacity" Value="0.4" />
                                        <Setter Target="Presenter.Opacity" Value="0.6" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次要按钮 -->
    <Style x:Key="PclSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PclSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PclBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PclControlCornerRadius}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="{StaticResource PclBodyFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Control.IsTemplateFocusTarget="True" />
                        <ContentPresenter
                            x:Name="Presenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclSurfaceHoverBrush}" />
                                        <Setter Target="Surface.BorderBrush" Value="{ThemeResource PclAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Opacity" Value="0.4" />
                                        <Setter Target="Presenter.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具栏上的轻按钮（无边框，悬停浅底） -->
    <Style x:Key="PclGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource PclControlCornerRadius}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="{StaticResource PclCaptionFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                                Control.IsTemplateFocusTarget="True" />
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclSurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 胶囊开关（隐私模式这类） -->
    <Style x:Key="PclPillToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource PclSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PclBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PclPillCornerRadius}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="{StaticResource PclCaptionFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border
                            x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Control.IsTemplateFocusTarget="True" />
                        <ContentPresenter
                            x:Name="Presenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclSurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentBrush}" />
                                        <Setter Target="Surface.BorderBrush" Value="{ThemeResource PclAccentBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentHoverBrush}" />
                                        <Setter Target="Surface.BorderBrush" Value="{ThemeResource PclAccentHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentPressedBrush}" />
                                        <Setter Target="Surface.BorderBrush" Value="{ThemeResource PclAccentPressedBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="White" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
