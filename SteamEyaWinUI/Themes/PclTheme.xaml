<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        PCL 风格设计令牌（视觉语言参考 Plain Craft Launcher 2 的整体观感：
        浅灰底 + 白色圆角卡片 + 蓝色强调 + 顶部横向导航）。
        本文件只定义自有的颜色、圆角与控件样式，不包含任何来自 PCL 的素材或代码。
    -->

    <!--
        语义色令牌：默认值即内置蓝色主题；用户在主题编辑器里改主色/辅助色后，
        ThemePaletteService 会在运行期覆盖这三套字典里的同名 Color。
    -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Default">
            <Color x:Key="PclAccentColor">#1370F3</Color>
            <Color x:Key="PclAccentHoverColor">#2E82F6</Color>
            <Color x:Key="PclAccentPressedColor">#0E5CD4</Color>
            <Color x:Key="PclAccentSoftColor">#E8F1FE</Color>
            <Color x:Key="PclFocusColor">#1370F3</Color>
            <Color x:Key="PclPageBackgroundColor">#F3F4F6</Color>
            <Color x:Key="PclSurfaceColor">#FFFFFF</Color>
            <Color x:Key="PclSurfaceAltColor">#FAFBFC</Color>
            <Color x:Key="PclSurfaceHoverColor">#F1F3F7</Color>
            <Color x:Key="PclInputColor">#FDFDFE</Color>
            <Color x:Key="PclDialogColor">#FFFFFF</Color>
            <Color x:Key="PclBorderColor">#E3E6EB</Color>
            <Color x:Key="PclBorderStrongColor">#D3D8E0</Color>
            <Color x:Key="PclDividerColor">#EDEFF3</Color>
            <Color x:Key="PclTextPrimaryColor">#1F2329</Color>
            <Color x:Key="PclTextSecondaryColor">#6B7280</Color>
            <Color x:Key="PclTextTertiaryColor">#9AA1AC</Color>
            <Color x:Key="PclTextDisabledColor">#B9BEC7</Color>
            <Color x:Key="PclOnAccentColor">#FFFFFF</Color>
            <Color x:Key="PclSuccessColor">#1E8E4E</Color>
            <Color x:Key="PclWarningColor">#B26A00</Color>
            <Color x:Key="PclErrorColor">#C02B2B</Color>
            <Color x:Key="PclInfoColor">#1F6FD0</Color>
            <Color x:Key="PclSuccessSoftColor">#E7F6EC</Color>
            <Color x:Key="PclWarningSoftColor">#FDF3E2</Color>
            <Color x:Key="PclErrorSoftColor">#FDEDED</Color>
            <Color x:Key="PclInfoSoftColor">#E8F1FE</Color>
            <Color x:Key="PclArtworkStartColor">#E8F1FE</Color>
            <Color x:Key="PclArtworkEndColor">#F5F8FD</Color>

            <!-- 旧页面使用的 WinUI 画刷别名 -->
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{ThemeResource PclSurfaceColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{ThemeResource PclSurfaceAltColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{ThemeResource PclBorderColor}" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{ThemeResource PclDividerColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{ThemeResource PclTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource PclTextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{ThemeResource PclTextTertiaryColor}" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{ThemeResource PclTextDisabledColor}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{ThemeResource PclInputColor}" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{ThemeResource PclSurfaceAltColor}" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{ThemeResource PclSurfaceHoverColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{ThemeResource PclBorderColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{ThemeResource PclBorderColor}" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{ThemeResource PclSurfaceHoverColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{ThemeResource PclPageBackgroundColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{ThemeResource PclSurfaceAltColor}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{ThemeResource PclSurfaceColor}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource PclAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource PclAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource PclAccentPressedColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{ThemeResource PclOnAccentColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="PclAccentColor">#1370F3</Color>
            <Color x:Key="PclAccentHoverColor">#2E82F6</Color>
            <Color x:Key="PclAccentPressedColor">#0E5CD4</Color>
            <Color x:Key="PclAccentSoftColor">#E8F1FE</Color>
            <Color x:Key="PclFocusColor">#1370F3</Color>
            <Color x:Key="PclPageBackgroundColor">#F3F4F6</Color>
            <Color x:Key="PclSurfaceColor">#FFFFFF</Color>
            <Color x:Key="PclSurfaceAltColor">#FAFBFC</Color>
            <Color x:Key="PclSurfaceHoverColor">#F1F3F7</Color>
            <Color x:Key="PclInputColor">#FDFDFE</Color>
            <Color x:Key="PclDialogColor">#FFFFFF</Color>
            <Color x:Key="PclBorderColor">#E3E6EB</Color>
            <Color x:Key="PclBorderStrongColor">#D3D8E0</Color>
            <Color x:Key="PclDividerColor">#EDEFF3</Color>
            <Color x:Key="PclTextPrimaryColor">#1F2329</Color>
            <Color x:Key="PclTextSecondaryColor">#6B7280</Color>
            <Color x:Key="PclTextTertiaryColor">#9AA1AC</Color>
            <Color x:Key="PclTextDisabledColor">#B9BEC7</Color>
            <Color x:Key="PclOnAccentColor">#FFFFFF</Color>
            <Color x:Key="PclSuccessColor">#1E8E4E</Color>
            <Color x:Key="PclWarningColor">#B26A00</Color>
            <Color x:Key="PclErrorColor">#C02B2B</Color>
            <Color x:Key="PclInfoColor">#1F6FD0</Color>
            <Color x:Key="PclSuccessSoftColor">#E7F6EC</Color>
            <Color x:Key="PclWarningSoftColor">#FDF3E2</Color>
            <Color x:Key="PclErrorSoftColor">#FDEDED</Color>
            <Color x:Key="PclInfoSoftColor">#E8F1FE</Color>
            <Color x:Key="PclArtworkStartColor">#E8F1FE</Color>
            <Color x:Key="PclArtworkEndColor">#F5F8FD</Color>

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{ThemeResource PclSurfaceColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{ThemeResource PclSurfaceAltColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{ThemeResource PclBorderColor}" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{ThemeResource PclDividerColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{ThemeResource PclTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource PclTextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{ThemeResource PclTextTertiaryColor}" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{ThemeResource PclTextDisabledColor}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{ThemeResource PclInputColor}" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{ThemeResource PclSurfaceAltColor}" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{ThemeResource PclSurfaceHoverColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{ThemeResource PclBorderColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{ThemeResource PclBorderColor}" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{ThemeResource PclSurfaceHoverColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{ThemeResource PclPageBackgroundColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{ThemeResource PclSurfaceAltColor}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{ThemeResource PclSurfaceColor}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource PclAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource PclAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource PclAccentPressedColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{ThemeResource PclOnAccentColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="PclAccentColor">#4A97FF</Color>
            <Color x:Key="PclAccentHoverColor">#63A7FF</Color>
            <Color x:Key="PclAccentPressedColor">#2E7FE8</Color>
            <Color x:Key="PclAccentSoftColor">#1D2C44</Color>
            <Color x:Key="PclFocusColor">#63A7FF</Color>
            <Color x:Key="PclPageBackgroundColor">#1B1C1F</Color>
            <Color x:Key="PclSurfaceColor">#252629</Color>
            <Color x:Key="PclSurfaceAltColor">#2B2D31</Color>
            <Color x:Key="PclSurfaceHoverColor">#32343A</Color>
            <Color x:Key="PclInputColor">#2A2C31</Color>
            <Color x:Key="PclDialogColor">#26282C</Color>
            <Color x:Key="PclBorderColor">#3A3D44</Color>
            <Color x:Key="PclBorderStrongColor">#4A4E57</Color>
            <Color x:Key="PclDividerColor">#303338</Color>
            <Color x:Key="PclTextPrimaryColor">#F2F3F5</Color>
            <Color x:Key="PclTextSecondaryColor">#A8ADB8</Color>
            <Color x:Key="PclTextTertiaryColor">#7C828D</Color>
            <Color x:Key="PclTextDisabledColor">#5E636B</Color>
            <Color x:Key="PclOnAccentColor">#FFFFFF</Color>
            <Color x:Key="PclSuccessColor">#4CCB7E</Color>
            <Color x:Key="PclWarningColor">#E0A13A</Color>
            <Color x:Key="PclErrorColor">#F06A6A</Color>
            <Color x:Key="PclInfoColor">#6FA8F0</Color>
            <Color x:Key="PclSuccessSoftColor">#16281E</Color>
            <Color x:Key="PclWarningSoftColor">#2A2113</Color>
            <Color x:Key="PclErrorSoftColor">#2C1A1A</Color>
            <Color x:Key="PclInfoSoftColor">#16233A</Color>
            <Color x:Key="PclArtworkStartColor">#1A2638</Color>
            <Color x:Key="PclArtworkEndColor">#202E44</Color>

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{ThemeResource PclSurfaceColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{ThemeResource PclSurfaceAltColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{ThemeResource PclBorderColor}" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{ThemeResource PclDividerColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{ThemeResource PclTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource PclTextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{ThemeResource PclTextTertiaryColor}" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{ThemeResource PclTextDisabledColor}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{ThemeResource PclInputColor}" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{ThemeResource PclSurfaceAltColor}" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{ThemeResource PclSurfaceHoverColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{ThemeResource PclBorderColor}" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{ThemeResource PclBorderColor}" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{ThemeResource PclSurfaceHoverColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{ThemeResource PclPageBackgroundColor}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{ThemeResource PclSurfaceAltColor}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{ThemeResource PclSurfaceColor}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource PclAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource PclAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource PclAccentPressedColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{ThemeResource PclOnAccentColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- 画刷：实例在启动时创建一次，主题服务会直接改它们的 Color -->
    <SolidColorBrush x:Key="PclAccentBrush" Color="{ThemeResource PclAccentColor}" />
    <SolidColorBrush x:Key="PclAccentHoverBrush" Color="{ThemeResource PclAccentHoverColor}" />
    <SolidColorBrush x:Key="PclAccentPressedBrush" Color="{ThemeResource PclAccentPressedColor}" />
    <SolidColorBrush x:Key="PclAccentSoftBrush" Color="{ThemeResource PclAccentSoftColor}" />
    <SolidColorBrush x:Key="PclFocusBrush" Color="{ThemeResource PclFocusColor}" />
    <SolidColorBrush x:Key="PclPageBackgroundBrush" Color="{ThemeResource PclPageBackgroundColor}" />
    <SolidColorBrush x:Key="PclSurfaceBrush" Color="{ThemeResource PclSurfaceColor}" />
    <SolidColorBrush x:Key="PclSurfaceAltBrush" Color="{ThemeResource PclSurfaceAltColor}" />
    <SolidColorBrush x:Key="PclSurfaceHoverBrush" Color="{ThemeResource PclSurfaceHoverColor}" />
    <SolidColorBrush x:Key="PclInputBrush" Color="{ThemeResource PclInputColor}" />
    <SolidColorBrush x:Key="PclDialogBrush" Color="{ThemeResource PclDialogColor}" />
    <SolidColorBrush x:Key="PclBorderBrush" Color="{ThemeResource PclBorderColor}" />
    <SolidColorBrush x:Key="PclBorderStrongBrush" Color="{ThemeResource PclBorderStrongColor}" />
    <SolidColorBrush x:Key="PclDividerBrush" Color="{ThemeResource PclDividerColor}" />
    <SolidColorBrush x:Key="PclTextPrimaryBrush" Color="{ThemeResource PclTextPrimaryColor}" />
    <SolidColorBrush x:Key="PclTextSecondaryBrush" Color="{ThemeResource PclTextSecondaryColor}" />
    <SolidColorBrush x:Key="PclTextTertiaryBrush" Color="{ThemeResource PclTextTertiaryColor}" />
    <SolidColorBrush x:Key="PclTextDisabledBrush" Color="{ThemeResource PclTextDisabledColor}" />
    <SolidColorBrush x:Key="PclOnAccentBrush" Color="{ThemeResource PclOnAccentColor}" />
    <SolidColorBrush x:Key="PclSuccessBrush" Color="{ThemeResource PclSuccessColor}" />
    <SolidColorBrush x:Key="PclWarningBrush" Color="{ThemeResource PclWarningColor}" />
    <SolidColorBrush x:Key="PclErrorBrush" Color="{ThemeResource PclErrorColor}" />
    <SolidColorBrush x:Key="PclInfoBrush" Color="{ThemeResource PclInfoColor}" />
    <SolidColorBrush x:Key="PclSuccessSoftBrush" Color="{ThemeResource PclSuccessSoftColor}" />
    <SolidColorBrush x:Key="PclWarningSoftBrush" Color="{ThemeResource PclWarningSoftColor}" />
    <SolidColorBrush x:Key="PclErrorSoftBrush" Color="{ThemeResource PclErrorSoftColor}" />
    <SolidColorBrush x:Key="PclInfoSoftBrush" Color="{ThemeResource PclInfoSoftColor}" />

    <!-- 形状与字号 -->
    <CornerRadius x:Key="PclCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="PclControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PclPillCornerRadius">18</CornerRadius>
    <x:Double x:Key="PclTitleFontSize">26</x:Double>
    <x:Double x:Key="PclSectionFontSize">15</x:Double>
    <x:Double x:Key="PclBodyFontSize">13</x:Double>
    <x:Double x:Key="PclCaptionFontSize">12</x:Double>

    <!-- 文字 -->
    <Style x:Key="PclTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PclTitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="PclSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PclCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PclSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PclSectionFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextPrimaryBrush}" />
    </Style>

    <Style x:Key="PclBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PclBodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextPrimaryBrush}" />
    </Style>

    <Style x:Key="PclCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource PclCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextSecondaryBrush}" />
    </Style>

    <!-- 容器 -->
    <Style x:Key="PclCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PclSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PclBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PclCardCornerRadius}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="PclToolbarCardStyle" TargetType="Border" BasedOn="{StaticResource PclCardStyle}">
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- 主按钮 -->
    <Style x:Key="PclPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PclAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource PclControlCornerRadius}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="{StaticResource PclBodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Control.IsTemplateFocusTarget="True" />
                        <ContentPresenter
                            x:Name="Presenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Opacity" Value="0.4" />
                                        <Setter Target="Presenter.Opacity" Value="0.6" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次要按钮 -->
    <Style x:Key="PclSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource PclSurfaceBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PclBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PclControlCornerRadius}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="{StaticResource PclBodyFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Control.IsTemplateFocusTarget="True" />
                        <ContentPresenter
                            x:Name="Presenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclSurfaceHoverBrush}" />
                                        <Setter Target="Surface.BorderBrush" Value="{ThemeResource PclAccentBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Opacity" Value="0.4" />
                                        <Setter Target="Presenter.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 工具栏上的轻按钮（无边框，悬停浅底） -->
    <Style x:Key="PclGhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource PclControlCornerRadius}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="{StaticResource PclCaptionFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                                Control.IsTemplateFocusTarget="True" />
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclSurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 胶囊开关（隐私模式这类） -->
    <Style x:Key="PclPillToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource PclSurfaceAltBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource PclTextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PclBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PclPillCornerRadius}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="{StaticResource PclCaptionFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border
                            x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Control.IsTemplateFocusTarget="True" />
                        <ContentPresenter
                            x:Name="Presenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclSurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Background" Value="{ThemeResource PclAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Surface.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <!-- 选中态配色由使用方在代码中显式设置：模板状态只保留空壳，
                                     避免主题切换后 VSM 残留的 Setter 覆盖局部画刷。 -->
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked" />
                                <VisualState x:Name="CheckedPointerOver" />
                                <VisualState x:Name="CheckedPressed" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
